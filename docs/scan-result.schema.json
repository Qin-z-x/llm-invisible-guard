{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Qin-z-x/llm-invisible-guard/main/docs/scan-result.schema.json",
  "title": "invisi-guard scan --json result",
  "description": "JSON document printed by `python -m invisi_guard scan FILE --json`. Findings follow docs/finding.schema.json. Exit code is 0 when no finding reaches --fail-on, 1 when it does, 2 for usage/IO errors.",
  "type": "object",
  "required": [
    "tool",
    "version",
    "file",
    "operation",
    "chars",
    "lines",
    "findings",
    "summary",
    "max_severity",
    "fail_on",
    "threshold_hit"
  ],
  "additionalProperties": false,
  "properties": {
    "tool": {"const": "invisi-guard"},
    "version": {"type": "string", "minLength": 1},
    "file": {"type": "string"},
    "operation": {"const": "scan"},
    "chars": {"type": "integer", "minimum": 0},
    "lines": {"type": "integer", "minimum": 0},
    "findings": {
      "type": "array",
      "items": {"$ref": "finding.schema.json"}
    },
    "summary": {
      "type": "object",
      "required": ["total", "low", "medium", "high", "by_code"],
      "additionalProperties": false,
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "by_code": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        }
      }
    },
    "max_severity": {"enum": ["low", "medium", "high", null]},
    "fail_on": {"enum": ["low", "medium", "high", null]},
    "threshold_hit": {"type": "boolean"}
  }
}
